# No real secrets belong in this file. Copy to .env locally.
FLAME_ENVIRONMENT=development
FLAME_LOG_LEVEL=INFO
FLAME_DATABASE_CONNECT_TIMEOUT=3
# FLAME_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/flame
# FLAME_SUPABASE_URL=https://project-ref.supabase.co
# FLAME_SUPABASE_ANON_KEY=sb_publishable_or_legacy_anon_key
# FLAME_SUPABASE_JWT_SECRET=legacy-hs256-secret-only-if-used
FLAME_SUPABASE_JWT_AUDIENCE=authenticated
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FLAME_SESSION_ENCRYPTION_KEY=generated-fernet-key
# FLAME_BFF_SHARED_KEY=long-random-shared-secret
# FLAME_WEB_ORIGIN=http://localhost:3000

# Server-only credential for confirmed Supabase Auth account deletion; never send to the BFF/browser.
# Prefer the current server-only secret key. Legacy service-role key remains supported.
FLAME_SUPABASE_SECRET_KEY=
# FLAME_SUPABASE_SERVICE_ROLE_KEY=


# Local completed-deletion receipt/tombstone window (owner policy: 30 days).
FLAME_DELETION_RECEIPT_RETENTION_DAYS=30


# Direct OpenAI Responses calls. Set both values to enable B7 answers.
# FLAME_LLM_OPENAI_API_KEY=server-only-project-key
# FLAME_LLM_MODEL=gpt-6-luna  # only model allowed by this OpenAI project
FLAME_LLM_TIMEOUT_SECONDS=12
FLAME_LLM_MAX_OUTPUT_TOKENS=1500
FLAME_LLM_DAILY_REQUEST_LIMIT=25

# Configure a monthly USD project hard spend limit in the OpenAI API platform.
# The daily member request cap above is not an aggregate spending limit.

# B9 private resource media. Production requires supabase and a private bucket.
FLAME_RESOURCE_STORAGE_BACKEND=local
FLAME_RESOURCE_LOCAL_DIR=../../../flame-resources
# FLAME_RESOURCE_STORAGE_BUCKET=flame-resources
# Comma-separated exact HTTPS media hostnames; empty disables external links.
FLAME_RESOURCE_ALLOWED_HOSTS=
FLAME_RESOURCE_LOCAL_DELIVERY_ORIGIN=http://127.0.0.1:8000
FLAME_RESOURCE_RECOMMENDATION_COUNT=3
FLAME_TEACHER_RECOMMENDATION_COUNT=2
FLAME_TEACHER_RECOMMENDATION_EVERY_N_TURNS=1

# Google Sheets manual resource sync: absolute server-only service-account JSON path.
FLAME_GOOGLE_SHEETS_CREDENTIALS_FILE=
# Vercel: server-only service-account JSON value; preferred over the local file path when set.
FLAME_GOOGLE_SHEETS_CREDENTIALS_JSON=

